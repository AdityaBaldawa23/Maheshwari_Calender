# Copy to .env.local (git-ignored) and fill in from Firebase console → Project settings → Your apps → Web app.
# These are public identifiers, NOT secrets (security comes from firestore.rules).
# Leave empty to build the app fully offline (directory shows "not yet published").
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
# Admin portal only:
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
