rules_version = '2';

// Maheshwari Digital Calendar — Firestore Security Rules
//
// Access model
//   Public (anyone, no sign-in):  READ  published/**  (directory snapshot, emergency, content, occasions)
//   Administrators:               READ/WRITE everything below, via the admin portal
//   Everyone else:                nothing
//
// An administrator is a signed-in user whose UID has a document admins/{uid}
// with active == true. That collection can NOT be written by any client — it is
// managed only in the Firebase console (or with the Admin SDK). See docs/V2_ADMIN.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // get() of a missing document fails the rule, i.e. non-admins are denied.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('active', false) == true;
    }

    function positiveInt(v) {
      return v is int && v > 0;
    }

    // ---- Admin roster: console / Admin SDK only -------------------------------
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // ---- Published (public read) ----------------------------------------------
    match /published/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && positiveInt(request.resource.data.version)
        && request.resource.data.schemaVersion is int
        && (docId in ['directory', 'emergency', 'content', 'calendar'] || docId.matches('occasions_[0-9]{4}'));
      allow delete: if isAdmin();

      // Directory snapshot chunks: published/directory/chunks/{version}_{n}
      match /chunks/{chunkId} {
        allow read: if docId == 'directory';
        allow create, update: if isAdmin() && docId == 'directory'
          && positiveInt(request.resource.data.version)
          && request.resource.data.index is int
          && request.resource.data.members is list
          && request.resource.data.members.size() <= 500
          && chunkId == string(request.resource.data.version) + '_' + string(request.resource.data.index);
        allow delete: if isAdmin();
      }
    }

    // ---- Private administrative data -------------------------------------------
    // Master member records (include private admin notes and inactive records).
    match /members/{memberId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.id == memberId
        && request.resource.data.status in ['active', 'inactive']
        && memberId.matches('[A-Za-z0-9][A-Za-z0-9_-]{0,39}');
      allow delete: if isAdmin();
    }

    // Drafts of emergency contacts, content and occasions (never public).
    match /drafts/{docId} {
      allow read, write: if isAdmin();
    }

    // Import history: append/update by the importing admin; never deleted by clients.
    match /imports/{importId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Publication history (audit trail): append-only.
    match /publications/{pubId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.publishedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
