{
  "name": "maheshwari-digital-calendar",
  "private": true,
  "version": "1.0.0",
  "description": "Maheshwari Digital Calendar — offline-first Hindi panchang calendar for the Maheshwari/Marwadi community",
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate-data && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-data": "node scripts/validate-data.mjs",
    "generate-panchang": "node scripts/generate-panchang.mjs",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.9",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/preferences": "7.0.4",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.6",
    "@fontsource/tiro-devanagari-hindi": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "4.7.0",
    "astronomy-engine": "2.1.19",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
